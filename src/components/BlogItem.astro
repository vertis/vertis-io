---
import { postUrl, formatDate, isoDate, type Post } from "../utils/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<div class="flex flex-col rounded-lg shadow-lg overflow-hidden">
  <div class="flex-shrink-0">
    {
      post.data.feature_image?.preview_url && (
        <img
          class="h-48 w-full object-cover"
          src={post.data.feature_image.preview_url}
          alt=""
        />
      )
    }
  </div>
  <div class="flex-1 bg-white p-6 flex flex-col justify-between">
    <div class="flex-1">
      <div class="flex space-x-1 text-sm text-gray-500">
        <time datetime={isoDate(post.data.date)}
          >{formatDate(post.data.date)}</time
        >
        {
          post.data.minutes_read && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>{post.data.minutes_read} min read</span>
            </>
          )
        }
      </div>
      <a href={postUrl(post)} class="block mt-2">
        <p class="text-xl font-semibold text-gray-900">
          {post.data.title}
        </p>
      </a>
    </div>
  </div>
</div>
