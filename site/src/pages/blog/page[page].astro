---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import BlogItem from "../../components/BlogItem.astro";
import Pagination from "../../components/Pagination.astro";
import { getSortedPosts, type Post } from "../../utils/posts";

export const getStaticPaths: GetStaticPaths = async () => {
  const PAGE_SIZE = 5;
  const posts = await getSortedPosts();
  const totalPages = Math.ceil(posts.length / PAGE_SIZE);
  // Jekyll's page 1 lives at /blog; paginated pages start at /blog/page2
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        posts: posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
      },
    };
  });
};

interface Props {
  page: number;
  totalPages: number;
  posts: Post[];
}

const { page, totalPages, posts } = Astro.props;
---

<Base
  title={`The Blog - Page ${page}`}
  description="The vertis.io Blog:  On Programming, Startups, and being a digital nomad."
>
  <div
    class="relative bg-gray-50 pt-16 pb-20 px-4 sm:px-6 lg:pt-24 lg:pb-28 lg:px-8"
  >
    <div class="absolute inset-0">
      <div class="bg-white h-1/3 sm:h-2/3"></div>
    </div>
    <div class="relative max-w-7xl mx-auto">
      <div class="text-center">
        <h2
          class="text-3xl tracking-tight font-extrabold text-gray-900 sm:text-4xl"
        >
          The Blog
        </h2>
        <p class="mt-3 max-w-2xl mx-auto text-xl text-gray-500 sm:mt-4">
          On Programming, Startups, and being a digital nomad.
        </p>
      </div>
      <div
        class="mt-12 max-w-lg mx-auto grid gap-5 lg:grid-cols-3 lg:max-w-none"
      >
        {posts.map((post) => <BlogItem post={post} />)}
      </div>
      <div class="mt-8 max-w-lg mx-auto lg:max-w-none">
        <Pagination page={page} totalPages={totalPages} />
      </div>
    </div>
  </div>
</Base>
